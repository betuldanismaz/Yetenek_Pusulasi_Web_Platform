@model Yetenek_Pusulasi_Web_Platform.Models.Entities.Scenario @* Bu View hala Scenario alıyor *@
@* ViewModel'i ayrı bir model olarak da tanımlayabilirdik veya ViewBag/ViewData ile taşıyabiliriz *@

@{
    ViewData["Title"] = "Senaryo Detayı";
    // Eğer ViewBag ile gönderildiyse, daha önce girilen cevabı alalım
    var previouslySubmittedAnswer = ViewBag.SubmittedAnswerText as string ?? "";
}

<h1>@Model.Title</h1>

@* TempData Mesajları *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}


<div>
    <h4>Senaryo</h4>
    <hr />
    <dl class="row">
        @* ... (Senaryo detayları aynı kalıyor) ... *@
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class="col-sm-2">
            İçerik
        </dt>
        <dd class="col-sm-10">
            <pre style="white-space: pre-wrap; font-family: inherit;">@Html.DisplayFor(model => model.Content)</pre>
        </dd>
    </dl>
</div>

<hr />

@if (User.Identity.IsAuthenticated)
{
    <div>
        <h4>Cevabınız</h4>
        @*
            Formun modeli olarak ScenarioAnswerViewModel kullanmak için
            Details view'inin @model direktifini de değiştirmek gerekebilir.
            Ya da bu formu bir partial view yapıp ona ViewModel geçebiliriz.
            Şimdilik, validasyon mesajlarını asp-validation-for ile göstermeye çalışalım
            ve controller'da ModelState'den gelen hataları manuel olarak ekleyebiliriz
            ya da Details view'i için de bir "parent" ViewModel oluşturup Scenario ve ScenarioAnswerViewModel'i içerebilir.
            En basit yaklaşım, validasyon mesajlarını göstermek ve form elemanlarının name'lerini korumaktır.
        *@
        <form asp-action="SubmitAnswer" asp-controller="Scenario" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ScenarioId" value="@Model.Id" />

            @* Genel model hataları için *@
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label for="AnswerText" class="control-label">Lütfen cevabınızı buraya yazın:</label>
                <textarea name="AnswerText" class="form-control" rows="10">@previouslySubmittedAnswer</textarea>
                @*
                    Burada `asp-validation-for` kullanmak için formun @model'inin
                    ScenarioAnswerViewModel tipinde bir property'ye sahip olması gerekir.
                    Şimdilik, controller'dan gelen ModelState hataları
                    `asp-validation-summary="All"` veya `ModelOnly` ile gösterilir.
                    Belirli bir alan için hata mesajını göstermek için
                    Details view'inin modelini daha karmaşık hale getirmemiz gerekir.
                    Veya JavaScript ile ModelState'den gelen hataları ilgili input'un altına ekleyebiliriz.

                    Daha temiz bir çözüm için, Details.cshtml'in de bir ViewModel (örn: ScenarioDetailsPageViewModel)
                    alması ve bu ViewModel'in hem Scenario bilgisini hem de ScenarioAnswerViewModel'i içermesi
                    daha doğru olur. O zaman asp-validation-for="AnswerViewModel.AnswerText" gibi kullanabiliriz.
                *@
                @* Geçici çözüm: AnswerText için özel hata mesajı (eğer varsa) *@
                @if (ViewData.ModelState.TryGetValue("AnswerText", out var answerTextErrorState) && answerTextErrorState.Errors.Any())
                {
                    <span class="text-danger">@answerTextErrorState.Errors.First().ErrorMessage</span>
                }
            </div>
            <div class="form-group mt-2">
                <input type="submit" value="Cevabı Gönder" class="btn btn-primary" />
            </div>
        </form>
    </div>
}
else
{
    <div class="alert alert-warning" role="alert">
        Senaryoya cevap verebilmek için <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Details", "Scenario", new { id = Model.Id })">giriş yapmanız</a> gerekmektedir.
    </div>
}

<div class="mt-3">
    <a asp-action="Index">Senaryo Listesine Geri Dön</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}