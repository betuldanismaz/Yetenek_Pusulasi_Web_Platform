@model Yetenek_Pusulasi_Web_Platform.Models.ViewModels.ScenarioDetailsViewModel

@{
    ViewData["Title"] = "Senaryo Detayı";
    // Eğer ViewBag ile gönderildiyse, daha önce girilen cevabı alalım
    var previouslySubmittedAnswer = ViewBag.SubmittedAnswerText as string ?? "";
}

<h1>@Model.Scenario.Title</h1>

@* TempData Mesajları *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}


<div>
    <h4>Senaryo</h4>
    <hr />
    <dl class="row">
        @* ... (Senaryo detayları aynı kalıyor) ... *@
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Scenario.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Scenario.Description)
        </dd>
        <dt class="col-sm-2">
            İçerik
        </dt>
        <dd class="col-sm-10">
            <pre style="white-space: pre-wrap; font-family: inherit;">@Html.DisplayFor(model => model.Scenario.Content)</pre>
        </dd>
    </dl>
</div>

<hr />

@if (User.Identity.IsAuthenticated)
{
    <div>
        <h4>Cevabınız</h4>
        <form asp-action="SubmitAnswer" asp-controller="Scenario" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ScenarioId" value="@Model.Scenario.Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="AnswerViewModel.AnswerText" class="control-label">Lütfen cevabınızı buraya yazın:</label>
                <textarea asp-for="AnswerViewModel.AnswerText" class="form-control" rows="10">@previouslySubmittedAnswer</textarea>
                <span asp-validation-for="AnswerViewModel.AnswerText" class="text-danger"></span>
            </div>
            <div class="form-group mt-2">
                <input type="submit" value="Cevabı Gönder" class="btn btn-primary" />
            </div>
        </form>
    </div>
}
else
{
    <div class="alert alert-warning" role="alert">
        Senaryoya cevap verebilmek için <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Details", "Scenario", new { id = Model.Scenario.Id })">giriş yapmanız</a> gerekmektedir.
    </div>
}

<div class="mt-3">
    <a asp-action="Index">Senaryo Listesine Geri Dön</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}